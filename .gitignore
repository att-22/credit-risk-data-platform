# --- Datos: nunca se versionan (pesan GB y tienen licencia de Kaggle) ---
data/
*.csv
*.parquet
*.zip
# Excepción: muestra pequeña (~2 MB) para ejecutar dbt en la CI (scripts/crear_muestra.py)
!tests/fixtures/muestra/raw/*.csv
# Excepción: seeds de dbt (datos de referencia propios, no de Kaggle)
!transform/seeds/*.csv

# --- Salidas generadas por el código (se recrean ejecutándolo) ---
outputs/
lake/

# --- Artefactos de dbt (SQL compilado, logs, paquetes descargados) ---
transform/target/
transform/logs/
transform/dbt_packages/
transform/.user.yml

# --- Spark en local (catálogo y tablas gestionadas del notebook de Databricks) ---
spark-warehouse/
metastore_db/
derby.log

# --- Modelos entrenados (se regeneran con el pipeline) ---
*.joblib
*.keras

# --- Entornos virtuales de Python ---
.venv/
venv/

# --- Archivos temporales que genera Python ---
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# --- Secretos y configuración local (rutas, claves) ---
.env

# --- Basura del sistema operativo / editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Terraform: plugins descargados y estado local (el lock SÍ se versiona) ---
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
